{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    // `bun test` resolves the shadcn components imported by registry/fm/react from the demo app.
    "paths": { "@/*": ["./apps/fm-web/src/*"] }
  },
  "include": ["registry/fm/core", "registry/fm/server", "registry/fm/drivers", "registry/fm/client", "registry/fm/thumbnails", "scripts"]
}
