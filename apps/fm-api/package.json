{
  "name": "@bkhq/fm-api",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nsl run -n fm:/api -s -- bun --watch src/index.ts",
    "dev:bare": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
