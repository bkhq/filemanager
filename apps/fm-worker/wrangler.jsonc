{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fm-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "r2_buckets": [
    { "binding": "FM_BUCKET", "bucket_name": "fm-files" }
  ],
  "assets": {
    "directory": "../fm-web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
