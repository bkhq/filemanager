# fm-api
# Root directory served by the "local" mount (default: .tmp/fm-root)
FM_ROOT=
# Optional upload session part size in bytes (default: 8 MiB)
FM_UPLOAD_PART_SIZE=
# Optional S3 mount (all four required to enable it)
FM_S3_ENDPOINT=
FM_S3_BUCKET=
FM_S3_ACCESS_KEY_ID=
FM_S3_SECRET_ACCESS_KEY=
FM_S3_REGION=us-east-1
